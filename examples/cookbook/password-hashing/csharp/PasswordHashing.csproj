<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Geralt (MIT): libsodium bindings; Argon2id via crypto_pwhash_str. Pulls libsodium native (ISC). -->
    <PackageReference Include="Geralt" Version="4.4.0" />
    <!-- Legacy bcrypt reader / fallback (MIT). -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />
  </ItemGroup>
</Project>
