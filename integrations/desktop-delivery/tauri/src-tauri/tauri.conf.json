{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genlib Inventory",
  "version": "0.1.0",
  "identifier": "dev.genlib.inventory",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Inventory label",
        "width": 640,
        "height": 460,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
