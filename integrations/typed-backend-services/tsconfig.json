{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": ".test-build",
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "erasableSyntaxOnly": true
  },
  "include": [
    "connect/**/*.ts",
    "generated/**/*.ts"
  ]
}
