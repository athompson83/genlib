{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/athompson83/genlib/schemas/quick.schema.json",
  "title": "genlib quick result",
  "type": "object",
  "required": [
    "query",
    "best",
    "next",
    "alternatives"
  ],
  "properties": {
    "query": {
      "type": "string"
    },
    "best": {
      "type": [
        "string",
        "null"
      ],
      "description": "type:id of the best match, or null when nothing fits"
    },
    "status": {
      "enum": [
        "no-match",
        "small-edit"
      ]
    },
    "title": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fit": {
      "enum": [
        "compatible",
        "review",
        "incompatible"
      ]
    },
    "review": {
      "type": "string"
    },
    "caveat": {
      "type": "string"
    },
    "next": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "commands to run, in order"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outline": {
      "type": "string"
    },
    "weak": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "incidental word matches shown with a no-match"
    },
    "hint": {
      "type": "string"
    },
    "fallback": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "unreviewed search commands outside the catalog"
    },
    "reuse": {
      "enum": [
        "direct",
        "partial"
      ],
      "description": "direct: tests verify every requirement of the asked feature; partial: the app must add some, or a caveat applies"
    },
    "covers": {
      "type": "object",
      "required": [
        "contract",
        "verified",
        "missing"
      ],
      "properties": {
        "contract": {
          "type": "string"
        },
        "verified": {
          "type": "string",
          "pattern": "^\\d+/\\d+$"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "description": "Behavior the module fixes that a task may contradict (routes, status codes, storage)"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "description": "Defaults the module lets the app change, with the option that changes each"
    },
    "size": {
      "type": "object",
      "required": [
        "lines",
        "files"
      ],
      "properties": {
        "lines": {
          "type": "integer"
        },
        "files": {
          "type": "integer"
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Where the copy lands in the app"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Install profiles of the module (genlib add <id> --profile a,b)"
    },
    "profile": {
      "type": "string",
      "description": "Suggested minimal profile selection, already applied to the add command in next"
    },
    "parts": {
      "type": "array",
      "description": "Standalone parts: a profile usable without the rest of the module, its size, what it is for and its key signatures (printed as # parts:)",
      "items": {
        "type": "object",
        "required": ["profile", "lines", "use", "api"],
        "properties": {
          "profile": { "type": "string" },
          "lines": { "type": "integer" },
          "use": { "type": "string" },
          "api": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "importFrom": {
      "type": "string",
      "description": "App path of the file that exports the main API"
    },
    "api": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "description": "Main functions as name(parameter names)"
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required fields of the options the app supplies"
    },
    "verify": {
      "type": "string"
    }
  }
}
