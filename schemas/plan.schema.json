{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/athompson83/genlib/schemas/plan.schema.json",
  "title": "genlib plan/add result (module install)",
  "type": "object",
  "required": [
    "target",
    "out",
    "modules",
    "files",
    "conflicts",
    "writes"
  ],
  "properties": {
    "target": {
      "type": "string"
    },
    "out": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "compatibility": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "action",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "action": {
            "enum": [
              "create",
              "unchanged",
              "conflict"
            ]
          },
          "bytes": {
            "type": "integer"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "totalBytes": {
      "type": "integer"
    },
    "tsImports": {
      "type": "boolean",
      "const": true,
      "description": "Present when --ts-imports rewrote relative .js imports in copied .ts/.tsx files to .ts."
    },
    "tsImportsDetected": {
      "type": "boolean",
      "const": true,
      "description": "Present when --ts-imports was not given and was turned on because the app has no tsconfig.json and a package.json script runs .ts files with node, deno or bun."
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Install profiles of the requested module that are installed (recorded ones plus --profile); absent when every file is installed."
    },
    "wiring": {
      "type": "string",
      "description": "The module's integration example from CONTRACT.md with import paths rewritten to the install location relative to the app root; imports of files not installed are omitted. At most 40 lines."
    },
    "writes": {
      "type": "boolean",
      "description": "false for plan (dry run)"
    },
    "status": {
      "enum": [
        "installed",
        "unchanged"
      ]
    },
    "created": {
      "type": "integer"
    },
    "provenance": {
      "type": "string"
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
