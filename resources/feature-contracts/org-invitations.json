{
  "id": "org-invitations",
  "title": "Invite teammates to an organization",
  "reviewed": "2026-10-11",
  "tasks": [
    "invite teammates to an organization"
  ],
  "requirements": [
    {
      "id": "authorized-invite",
      "text": "Only members allowed to invite can do so, and they cannot grant a role above their own"
    },
    {
      "id": "token-security",
      "text": "Invitation tokens are random, stored only as hashes and expire; revoked, expired and unknown tokens fail"
    },
    {
      "id": "email-bound",
      "text": "Accepting requires a signed-in user whose verified email matches the invitation"
    },
    {
      "id": "single-accept",
      "text": "An invitation is accepted once even under concurrent accepts, and membership is created in the same transaction"
    },
    {
      "id": "revoke-rotate",
      "text": "Admins can revoke invitations, and re-inviting an address rotates the link so only the newest works"
    },
    {
      "id": "tenant-isolation",
      "text": "Invitations cannot be listed, revoked or used across tenants"
    },
    {
      "id": "invite-limits",
      "text": "Pending invitations are capped per tenant"
    },
    {
      "id": "delivery-failure",
      "text": "A failed invitation email is reported and leaves no usable pending invitation"
    }
  ],
  "implementations": [
