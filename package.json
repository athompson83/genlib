{
  "name": "@genisys/genlib",
  "version": "0.1.0",
  "private": true,
  "description": "A versioned source registry and coding-agent skill for reusable application features.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/athompson83/genlib.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "genlib": "bin/genlib.mjs"
  },
  "files": [
    "bin",
    "lib",
    "modules",
    "registry",
    "schemas",
    "skills",
    "scripts",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "skills:install": "node scripts/install-skills.mjs",
    "check": "npm run registry:check && npm run skills:check && npm test"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
