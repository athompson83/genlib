{
  "name": "@genisys/genlib",
  "version": "0.2.0",
  "private": true,
  "description": "A versioned source registry and coding-agent skill for reusable application features.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/athompson83/genlib.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "genlib": "bin/genlib.mjs",
    "genlib-mcp": "bin/genlib-mcp.mjs"
  },
  "files": [
    "bin",
    "lib",
    "modules",
    "integrations",
    "packages/genlib-mcp",
    "registry",
    "schemas",
    "skills",
    "scripts",
    "docs",
    "resources",
    "templates",
    "tools",
    "LICENSE",
    "NOTICE",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "integrations:build": "node scripts/build-integrations.mjs",
    "integrations:check": "node scripts/build-integrations.mjs --check && node scripts/check-integration-bindings.mjs",
    "mcp:test": "npm test --prefix packages/genlib-mcp",
    "retrieval:check": "node tools/retrieval-eval.mjs --check",
    "catalog:health": "node tools/catalog-health.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "skills:install": "node scripts/install-skills.mjs",
    "resources": "node tools/resources.mjs",
    "resources:check": "node tools/resources.mjs validate --json",
    "check": "npm run registry:check && npm run integrations:check && npm run skills:check && npm run resources:check && npm run docs:check && npm run index:check && npm run graph:check && npm test",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:check": "node scripts/sync-docs.mjs --check",
    "index:build": "node scripts/build-search-index.mjs",
    "index:check": "node scripts/build-search-index.mjs --check",
    "resources:verify": "node scripts/verify-resources.mjs",
    "graph:build": "node scripts/build-graph.mjs",
    "graph:check": "node scripts/build-graph.mjs --check",
    "obsidian:export": "node scripts/export-obsidian.mjs",
    "mcp": "node bin/genlib-mcp.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@5.9.3"
  }
}
